# ==========================================
# OmniDesk Platform Environment Configuration
# ==========================================

# Server Configuration
PORT=3001
NODE_ENV=production
CORS_ORIGIN=*

# Security
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production!

# Microsoft SQL Server Database Connection
# Supports Windows ODBC Driver 17 for Local / Express instance
MSSQL_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=.\\SQLEXPRESS;Database=BillingOmnichannel;Trusted_Connection=yes;

# Messaging Channels Storage
WA_SESSION_DIR=./sessions/whatsapp
TG_SESSION_DIR=./sessions/telegram

# Telegram MTProto API Credentials (from my.telegram.org)
TG_API_ID=
TG_API_HASH=
